# Streamlit Cloud → Settings → Secrets bölümüne bu yapıyı yapıştırın.
# Lokal test: kopyalayıp secrets.toml yapın (secrets.toml repoya EKLENMEMELİ).

[supabase]
host = "db.PROJE_ID.supabase.co"
user = "postgres"
pooler_host = "aws-0-eu-central-1.pooler.supabase.com"
pooler_user = "postgres.PROJE_ID"
port = 5432
dbname = "postgres"
password = "BURAYA_SUPABASE_SIFRESI"

[auth]
mobil_password = "guclu_mobil_sifre"
servis_password = "guclu_servis_sifre"
admin_password = "guclu_admin_sifre"

# İsteğe bağlı — AI asistan sekmesi için
# GEMINI_API_KEY = "buraya_api_key"
